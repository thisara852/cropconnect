rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isFarmer() {
      return isAuthenticated() && (
        request.auth.token.role == 'farmer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'farmer')
      );
    }

    function isBuyer() {
      return isAuthenticated() && (
        request.auth.token.role == 'buyer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'buyer')
      );
    }

    // 1. Users Collection
    // Public profile details readable; private fields protected; users can update own profile; role cannot be self-elevated to admin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role in ['farmer', 'buyer'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Businesses Collection (Commercial Buyers)
    match /businesses/{businessId} {
      allow read: if isAuthenticated();
      allow create: if isBuyer() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isBuyer() && resource.data.ownerId == request.auth.uid && request.resource.data.verificationStatus == resource.data.verificationStatus) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Crop Listings Collection (Farmer harvest lots)
    match /cropListings/{listingId} {
      allow read: if true; // Public marketplace browsing
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid;
      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid) || isAdmin();
      allow delete: if (isFarmer() && resource.data.farmerId == request.auth.uid) || isAdmin();
    }

    // 4. Offers Collection (Bilateral transactions between Farmer and Buyer)
    match /offers/{offerId} {
      // Readable only by the involved buyer, the target farmer, or administrators
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      // Buyers can create offers
      allow create: if isBuyer() && request.resource.data.buyerId == request.auth.uid;
      // Farmers can accept/reject; Buyers can cancel pending offers; Admins can mediate
      allow update: if isAuthenticated() && (
        (resource.data.farmerId == request.auth.uid && request.resource.data.status in ['Accepted', 'Rejected']) ||
        (resource.data.buyerId == request.auth.uid && resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Purchase Requirements Collection (Posted by Buyers)
    match /purchaseRequirements/{reqId} {
      allow read: if true; // Public demand visibility
      allow create: if isBuyer() && request.resource.data.buyerId == request.auth.uid;
      allow update: if (isBuyer() && resource.data.buyerId == request.auth.uid) || isAdmin();
      allow delete: if (isBuyer() && resource.data.buyerId == request.auth.uid) || isAdmin();
    }

    // 6. Crop Prices Collection (Market Benchmarks)
    match /cropPrices/{priceId} {
      allow read: if true; // Public transparency
      allow write: if isAdmin(); // Only admins can modify official price benchmarks
    }

    // 7. Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // 8. Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (resource.data.submittedBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 9. Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
