# CROPCONNECT - Firebase & Environment Configuration
# Copy this file to .env and replace the placeholder values with your real Firebase Project credentials.
# Note: For Expo / React Native, environment variables exposed to the client should use EXPO_PUBLIC_ prefix.

# Firebase Project Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=cropconnect-lk.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cropconnect-lk
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=cropconnect-lk.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# Backend Environment Mode (production | development | demo)
EXPO_PUBLIC_APP_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_FIREBASE_AUTH=true
EXPO_PUBLIC_ENABLE_FIRESTORE=true
EXPO_PUBLIC_ENABLE_STORAGE=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
